        "stage_2_small_group"
      ],
      "expansion_criteria": "blocking_preconditions 全部 accepted（含 R24 传输安全与授权、R16/R27 各能力面的 owner 决定）；发布矩阵逐能力面与实际一致",
      "stop_criteria": "任一风险未接受，或矩阵中仍存在 unverified/blocked_external 能力",
      "receipt_required": "发布 owner 签字（助手不代签）",
      "owner_role": "发布 owner",
      "status": "not_started",
      "receipt": null
    }
