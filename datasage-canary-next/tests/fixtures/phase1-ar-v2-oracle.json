{
  "schema_version": "phase1-ar-v2-independent.v1",
  "status": "frozen-after-user-decisions-before-v2-execution",
  "purpose": "应收 v2 的独立金额来源与严格时点对齐验收；保留 v1 oracle，不把 open_receivable_amount 或逾期项目合计偷换成客户净欠款。",
  "frozen_basis": {
    "amount_source": "current_debt_amount",
    "amount_meaning": "latest monthly customer signed net-debt snapshot, including positive, zero, and negative values",
    "amount_unit": "CNY yuan",
    "parent_customer_set": "customers present in the latest current_debt_amount snapshot; current-open-only customers are not added",
    "overdue_source": "current open receivable item observation using overdue_days > 30",
    "time_policy": "same business as-of time is required for the joint predicate",
    "alignment_rule": "latest monthly debt snapshot and current open-item observation have no authoritative same-asof bridge; same SQL/read clock is not proof of same business time",
    "strict_joint_rule": "if debt amount is inside range or unknown and the two as-of times are not authoritatively aligned, joint result is unknown; an observed current late=false cannot prove the monthly snapshot late=false",
    "outside_rule": "known debt amount outside 10000..50000 inclusive is excluded even when current late=true",
    "v1_preserved": "acceptance-oracles.json and acceptance-oracles.sha256 remain unchanged",
    "model_execution": "not_run",
    "real_data_execution": "not_run"
  },
  "public_request": {
    "domain": "receivable",
    "metric": "current_debt_amount",
    "dimensions": ["customer"],
    "analysis": {
      "row_filters": [{"field": "overdue_days", "op": "gt", "value": "30"}],
      "group_filters": [
        {"field": "metric_value", "op": "gte", "value": "10000"},
        {"field": "metric_value", "op": "lte", "value": "50000"},
        {"field": "any_overdue_days", "op": "gt", "value": "30"}
      ]
    },
    "order_by": {"field": "metric_value", "direction": "desc"},
    "limit": 20
  },
  "asof": {
    "debt_snapshot_period": "2026-08",
    "debt_snapshot_asof": "2026-08-31",
    "open_observation_asof": "2026-09-02",
