      "strict_time_alignment": {"max": 5, "full_credit": "reports debt_asof and overdue_asof separately and joint unknown without authoritative bridge"},
      "boundary_and_numeric": {"max": 4, "full_credit": "inside includes 10000/50000, outside excludes, negatives/zero do not qualify"},
      "unknown_and_evidence": {"max": 4, "full_credit": "inside/unknown amount with misaligned time stays unknown; current late=false never proves joint false"},
      "source_difference": {"max": 3, "full_credit": "explains prepayment/writeoff counterexamples and does not substitute open-item sum"},
