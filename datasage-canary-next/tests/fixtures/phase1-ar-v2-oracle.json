    {"id": "ARV2-M02-current-only-expansion", "mutation": "add C-CURRENT-ONLY from overdue source to parent customer set", "must_fail": true, "caught_by": ["C-CURRENT-ONLY"]},
    {"id": "ARV2-M03-time-align-by-read-clock", "mutation": "treat same SQL/CURDATE read as same business as-of", "must_fail": true, "caught_by": ["C-LOW-BOUND", "C-IN-NO-LATE", "C-PREPAY-OFFSET"]},
    {"id": "ARV2-M04-current-false-to-joint-false", "mutation": "set C-IN-NO-LATE joint predicate false despite misaligned as-of", "must_fail": true, "caught_by": ["C-IN-NO-LATE"]},
    {"id": "ARV2-M05-missing-debt-zero", "mutation": "coerce C-DEBT-MISSING debt to zero/outside", "must_fail": true, "caught_by": ["C-DEBT-MISSING"]},
    {"id": "ARV2-M06-inclusive-boundaries", "mutation": "use gt 10000 or lt 50000", "must_fail": true, "caught_by": ["C-LOW-BOUND", "C-HIGH-BOUND"]},
    {"id": "ARV2-M07-late-boundary", "mutation": "use gte 30 for overdue existence", "must_fail": true, "caught_by": ["C-IN-NO-LATE"]},
    {"id": "ARV2-M08-old-month", "mutation": "use 2026-07 debt row instead of latest 2026-08 snapshot", "must_fail": true, "caught_by": ["C-MID"]}
