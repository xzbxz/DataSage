# Environment variables required by this Hermes distribution.
# Copy to `.env` and fill in your own values before running.

# DeepSeek API key used by the Profile model provider.
# (required)
DEEPSEEK_API_KEY=

# MySQL host used by the governed read-only query plugin.
# (required)
DATA_QUERY_MYSQL_HOST=

# MySQL port.
# (optional)
DATA_QUERY_MYSQL_PORT=

# MySQL database containing the governed views and tables.
# (required)
DATA_QUERY_MYSQL_DATABASE=

# MySQL account used by the read-only DataSage query plugin.
# (required)
DATA_QUERY_MYSQL_USER=

# Password for the DataSage MySQL account.
# (required)
DATA_QUERY_MYSQL_PASSWORD=

# Optional CA certificate path for verified MySQL TLS.
# (optional)
DATA_QUERY_MYSQL_SSL_CA=

# WeCom AI Bot ID.
# (required)
WECOM_BOT_ID=

# WeCom AI Bot secret.
# (required)
WECOM_SECRET=

# WeCom home channel used by this canary profile.
# (optional for non-WeCom runs)
WECOM_HOME_CHANNEL=

# WeCom home channel thread identifier.
# (optional for non-WeCom runs)
WECOM_HOME_CHANNEL_THREAD_ID=
